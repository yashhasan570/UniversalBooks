msgid "Push selected books and their metadata into your Universal Books cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "Envie os livros selecionados e os seus metadados para a sua biblioteca na nuvem Universal Books. Reenviar um livro atualiza a entrada existente em vez de criar uma duplicada."

msgid "Not logged in."
msgstr "Sessão não iniciada."

msgid "Include custom columns in pushed metadata"
msgstr "Incluir colunas personalizadas nos metadados enviados"

msgid "Only change this if you run a self-hosted Universal Books server."
msgstr "Altere isto apenas se executar um servidor Universal Books autoalojado."

msgid "Logged in as %s."
msgstr "Sessão iniciada como %s."

msgid "API server:"
msgstr "Servidor de API:"

msgid "Use the Universal Books toolbar menu to log in or out."
msgstr "Use o menu Universal Books da barra de ferramentas para iniciar ou terminar sessão."

msgid "Push to Universal Books"
msgstr "Enviar para o Universal Books"

msgid "Push to Universal Books failed"
msgstr "Falha ao enviar para o Universal Books"

msgid "Universal Books status"
msgstr "Estado do Universal Books"

msgid "Universal Books status check failed"
msgstr "Falha na verificação do estado do Universal Books"

msgid "Log in to Universal Books"
msgstr "Iniciar sessão no Universal Books"

msgid "Email:"
msgstr "E-mail:"

msgid "Password:"
msgstr "Palavra-passe:"

msgid "Log in"
msgstr "Iniciar sessão"

msgid "Logging in…"
msgstr "A iniciar sessão…"

msgid "Waiting for the browser login to complete…"
msgstr "A aguardar a conclusão do início de sessão no navegador…"

msgid "Unknown"
msgstr "Desconhecido"

msgid "Pushing %d book to your Universal Books library…"
msgid_plural "Pushing %d books to your Universal Books library…"
msgstr[0] "A enviar %d livro para a sua biblioteca Universal Books…"
msgstr[1] "A enviar %d livros para a sua biblioteca Universal Books…"

msgid "Checking %d book against your Universal Books library…"
msgid_plural "Checking %d books against your Universal Books library…"
msgstr[0] "A verificar %d livro na sua biblioteca Universal Books…"
msgstr[1] "A verificar %d livros na sua biblioteca Universal Books…"

msgid "Or sign in with your browser:"
msgstr "Ou inicie sessão com o seu navegador:"

msgid "Please enter both email and password."
msgstr "Introduza o e-mail e a palavra-passe."

msgid "Login failed: the browser callback carried no session."
msgstr "Falha ao iniciar sessão: a resposta do navegador não trouxe nenhuma sessão."

msgid "Book"
msgstr "Livro"

msgid "Status"
msgstr "Estado"

msgid "Details"
msgstr "Detalhes"

msgid "Canceling…"
msgstr "A cancelar…"

msgid "Browser login timed out. Try again."
msgstr "O início de sessão no navegador expirou. Tente novamente."

msgid "Login failed: %s"
msgstr "Falha ao iniciar sessão: %s"

msgid "Universal Books Login"
msgstr "Início de sessão no Universal Books"

msgid "Completing login…"
msgstr "A concluir o início de sessão…"

msgid "Login complete. You can close this tab and return to calibre."
msgstr "Início de sessão concluído. Pode fechar este separador e voltar ao calibre."

msgid "Universal Books"
msgstr "Universal Books"

msgid "Push selected books and metadata to your Universal Books library"
msgstr "Enviar os livros selecionados e os metadados para a sua biblioteca Universal Books"

msgid "Select the books to push to Universal Books."
msgstr "Selecione os livros a enviar para o Universal Books."

msgid "Select the books to check against Universal Books."
msgstr "Selecione os livros a verificar no Universal Books."

msgid "No books selected"
msgstr "Nenhum livro selecionado"

msgid "Push selected books to Universal Books"
msgstr "Enviar os livros selecionados para o Universal Books"

msgid "Check Universal Books status"
msgstr "Verificar o estado do Universal Books"

msgid "Log in to Universal Books…"
msgstr "Iniciar sessão no Universal Books…"

msgid "Log out"
msgstr "Terminar sessão"

msgid "Customize plugin…"
msgstr "Personalizar o plugin…"

msgid "Log out (%s)"
msgstr "Terminar sessão (%s)"

msgid "your Universal Books account"
msgstr "a sua conta Universal Books"

msgid "Uploaded"
msgstr "Enviado"

msgid "Replaced"
msgstr "Substituído"

msgid "Updated"
msgstr "Atualizado"

msgid "Up to date"
msgstr "Em dia"

msgid "Failed"
msgstr "Falhou"

msgid "In Universal Books"
msgstr "No Universal Books"

msgid "Metadata differs"
msgstr "Metadados diferentes"

msgid "Out of date"
msgstr "Desatualizado"

msgid "Not in Universal Books"
msgstr "Não está no Universal Books"

msgid "No Universal Books-supported format (EPUB, PDF, ...)"
msgstr "Nenhum formato suportado pelo Universal Books (EPUB, PDF, ...)"

msgid "Book file is missing from the calibre library"
msgstr "O ficheiro do livro não está na biblioteca do calibre"

msgid "Nothing to push."
msgstr "Nada para enviar."

msgid "Nothing to check."
msgstr "Nada para verificar."

msgid "Please log in to Universal Books first. (%s)"
msgstr "Inicie sessão no Universal Books primeiro. (%s)"

msgid "Could not reach Universal Books: %s"
msgstr "Não foi possível contactar o Universal Books: %s"

msgid "Canceled."
msgstr "Cancelado."

msgid "Universal Books storage quota exceeded — push stopped."
msgstr "Quota de armazenamento do Universal Books excedida — envio interrompido."

msgid "Session expired — please log in again."
msgstr "Sessão expirada — inicie sessão novamente."

msgid "Login failed"
msgstr "Falha ao iniciar sessão"

msgid "Not logged in"
msgstr "Sessão não iniciada"

msgid "Session expired, please log in again"
msgstr "Sessão expirada, inicie sessão novamente"

msgid "Not authenticated"
msgstr "Não autenticado"

msgid "Request failed (%s)"
msgstr "O pedido falhou (%s)"

msgid "Upload failed (%s)"
msgstr "O envio falhou (%s)"

