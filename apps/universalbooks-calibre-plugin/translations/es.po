msgid "Push selected books and their metadata into your Universal Books cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "Envíe los libros seleccionados y sus metadatos a su biblioteca en la nube de Universal Books. Al volver a enviar un libro se actualiza su entrada existente en lugar de crear un duplicado."

msgid "Not logged in."
msgstr "No ha iniciado sesión."

msgid "Include custom columns in pushed metadata"
msgstr "Incluir columnas personalizadas en los metadatos enviados"

msgid "Only change this if you run a self-hosted Universal Books server."
msgstr "Cambie esto solo si utiliza un servidor Universal Books autoalojado."

msgid "Logged in as %s."
msgstr "Sesión iniciada como %s."

msgid "API server:"
msgstr "Servidor de API:"

msgid "Use the Universal Books toolbar menu to log in or out."
msgstr "Use el menú Universal Books de la barra de herramientas para iniciar o cerrar sesión."

msgid "Push to Universal Books"
msgstr "Enviar a Universal Books"

msgid "Push to Universal Books failed"
msgstr "Error al enviar a Universal Books"

msgid "Universal Books status"
msgstr "Estado de Universal Books"

msgid "Universal Books status check failed"
msgstr "Error al comprobar el estado de Universal Books"

msgid "Log in to Universal Books"
msgstr "Iniciar sesión en Universal Books"

msgid "Email:"
msgstr "Correo electrónico:"

msgid "Password:"
msgstr "Contraseña:"

msgid "Log in"
msgstr "Iniciar sesión"

msgid "Logging in…"
msgstr "Iniciando sesión…"

msgid "Waiting for the browser login to complete…"
msgstr "Esperando que se complete el inicio de sesión en el navegador…"

msgid "Unknown"
msgstr "Desconocido"

msgid "Pushing %d book to your Universal Books library…"
msgid_plural "Pushing %d books to your Universal Books library…"
msgstr[0] "Enviando %d libro a su biblioteca Universal Books…"
msgstr[1] "Enviando %d libros a su biblioteca Universal Books…"

msgid "Checking %d book against your Universal Books library…"
msgid_plural "Checking %d books against your Universal Books library…"
msgstr[0] "Comprobando %d libro contra su biblioteca Universal Books…"
msgstr[1] "Comprobando %d libros contra su biblioteca Universal Books…"

msgid "Or sign in with your browser:"
msgstr "O inicie sesión con su navegador:"

msgid "Please enter both email and password."
msgstr "Introduzca el correo electrónico y la contraseña."

msgid "Login failed: the browser callback carried no session."
msgstr "Error de inicio de sesión: la respuesta del navegador no contenía ninguna sesión."

msgid "Book"
msgstr "Libro"

msgid "Status"
msgstr "Estado"

msgid "Details"
msgstr "Detalles"

msgid "Canceling…"
msgstr "Cancelando…"

msgid "Browser login timed out. Try again."
msgstr "El inicio de sesión en el navegador caducó. Inténtelo de nuevo."

msgid "Login failed: %s"
msgstr "Error de inicio de sesión: %s"

msgid "Universal Books Login"
msgstr "Inicio de sesión en Universal Books"

msgid "Completing login…"
msgstr "Completando el inicio de sesión…"

msgid "Login complete. You can close this tab and return to calibre."
msgstr "Inicio de sesión completado. Puede cerrar esta pestaña y volver a calibre."

msgid "Universal Books"
msgstr "Universal Books"

msgid "Push selected books and metadata to your Universal Books library"
msgstr "Enviar los libros seleccionados y sus metadatos a su biblioteca Universal Books"

msgid "Select the books to push to Universal Books."
msgstr "Seleccione los libros que desea enviar a Universal Books."

msgid "Select the books to check against Universal Books."
msgstr "Seleccione los libros que desea comprobar con Universal Books."

msgid "No books selected"
msgstr "No hay libros seleccionados"

msgid "Push selected books to Universal Books"
msgstr "Enviar los libros seleccionados a Universal Books"

msgid "Check Universal Books status"
msgstr "Comprobar el estado de Universal Books"

msgid "Log in to Universal Books…"
msgstr "Iniciar sesión en Universal Books…"

msgid "Log out"
msgstr "Cerrar sesión"

msgid "Customize plugin…"
msgstr "Personalizar complemento…"

msgid "Log out (%s)"
msgstr "Cerrar sesión (%s)"

msgid "your Universal Books account"
msgstr "su cuenta de Universal Books"

msgid "Uploaded"
msgstr "Subido"

msgid "Replaced"
msgstr "Reemplazado"

msgid "Updated"
msgstr "Actualizado"

msgid "Up to date"
msgstr "Al día"

msgid "Failed"
msgstr "Fallido"

msgid "In Universal Books"
msgstr "En Universal Books"

msgid "Metadata differs"
msgstr "Metadatos diferentes"

msgid "Out of date"
msgstr "Obsoleto"

msgid "Not in Universal Books"
msgstr "No en Universal Books"

msgid "No Universal Books-supported format (EPUB, PDF, ...)"
msgstr "Ningún formato compatible con Universal Books (EPUB, PDF, ...)"

msgid "Book file is missing from the calibre library"
msgstr "El archivo del libro falta en la biblioteca de calibre"

msgid "Nothing to push."
msgstr "Nada que enviar."

msgid "Nothing to check."
msgstr "Nada que comprobar."

msgid "Please log in to Universal Books first. (%s)"
msgstr "Inicie sesión en Universal Books primero. (%s)"

msgid "Could not reach Universal Books: %s"
msgstr "No se pudo contactar con Universal Books: %s"

msgid "Canceled."
msgstr "Cancelado."

msgid "Universal Books storage quota exceeded — push stopped."
msgstr "Cuota de almacenamiento de Universal Books superada: envío detenido."

msgid "Session expired — please log in again."
msgstr "Sesión caducada: inicie sesión de nuevo."

msgid "Login failed"
msgstr "Error de inicio de sesión"

msgid "Not logged in"
msgstr "No ha iniciado sesión"

msgid "Session expired, please log in again"
msgstr "Sesión caducada, inicie sesión de nuevo"

msgid "Not authenticated"
msgstr "No autenticado"

msgid "Request failed (%s)"
msgstr "Error en la solicitud (%s)"

msgid "Upload failed (%s)"
msgstr "Error al subir (%s)"

