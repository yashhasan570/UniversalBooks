msgstr "Desatualizado"

msgid "Not in Universal Books"
msgstr "Não está no Universal Books"

msgid "No Universal Books-supported format (EPUB, PDF, ...)"
msgstr "Nenhum formato suportado pelo Universal Books (EPUB, PDF, ...)"

msgid "Book file is missing from the calibre library"
msgstr "O arquivo do livro está ausente na biblioteca do calibre"

msgid "Nothing to push."
msgstr "Nada para enviar."

msgid "Nothing to check."
msgstr "Nada para verificar."

msgid "Please log in to Universal Books first. (%s)"
msgstr "Entre no Universal Books primeiro. (%s)"

msgid "Could not reach Universal Books: %s"
msgstr "Não foi possível alcançar o Universal Books: %s"

msgid "Canceled."
msgstr "Cancelado."

msgid "Universal Books storage quota exceeded — push stopped."
msgstr "Cota de armazenamento do Universal Books excedida — envio interrompido."

msgid "Session expired — please log in again."
msgstr "Sessão expirada — entre novamente."

msgid "Login failed"
msgstr "Falha no login"

msgid "Not logged in"
